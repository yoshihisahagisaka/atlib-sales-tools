{
  "name": "sales-tools",
  "version": "0.1.0",
  "private": true,
  "description": "atLIB 営業支援ツール（原価見積ツール + ISMS支援プラン診断フォーム）。msp-customer-portalから分離。",
  "main": "dist/server.js",
  "scripts": {
    "verify:pira:validation": "node scripts/pira/verifyValidationPackage.cjs",
    "test:pira:realpg": "npm run build && node --test test/piraValidationPreparation.test.cjs test/piraPhase1.realpg.test.cjs",
    "test:pira": "npm run build && node --test test/piraPhase1.test.cjs",
    "test:pira:browser": "node test/piraPhase1.browser.cjs",
    "preflight:pira": "node scripts/pira/preflight.cjs",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "test:kaizen": "node -r ts-node/register --test test/kaizenAssessment.golden.test.ts",
    "test:diagnosis": "node -r ts-node/register --test test/itManagementDiagnosis.golden.test.ts",
    "test:preparation": "node -r ts-node/register --test test/diagnosisPreparation.golden.test.ts",
    "test:business-web-consultation": "node -r ts-node/register --test test/businessWebConsultation.golden.test.ts",
    "test:business-web-consultation:api": "node -r ts-node/register --test test/businessWebConsultation.api.test.ts",
    "test:business-web-consultation:browser": "playwright test --config=test/businessWebConsultation.playwright.config.ts",
    "test:diagnosis:browser": "playwright test --config=test/diagnosis.playwright.config.ts",
    "migrate": "node --env-file=.env -r ts-node/register migrations/runner.ts",
    "import:market-rates": "node --env-file=.env -r ts-node/register scripts/cost_estimation/import_market_rates.ts",
    "export:catalog-for-research": "node --env-file=.env -r ts-node/register scripts/cost_estimation/export_catalog_for_research.ts",
    "import:market-baseline": "node --env-file=.env -r ts-node/register scripts/cost_estimation/import_market_baseline.ts",
    "test:workspace": "node -r ts-node/register --test test/diagnosisWorkspace.golden.test.ts",
    "test:review": "node -r ts-node/register --test test/diagnosisReview.golden.test.ts",
    "test:handoff": "node -r ts-node/register --test test/diagnosisAssessment.golden.test.ts",
    "test:report": "node -r ts-node/register --test test/diagnosisReport.golden.test.ts",
    "test:readiness": "node -r ts-node/register --test test/productionReadiness.security.test.ts",
    "test:readiness:postgres": "node -r ts-node/register --test test/productionReadiness.postgres.test.ts",
    "test:cleanup-contract": "node -r ts-node/register --test test/productionTestDataCleanup.contract.test.ts",
    "test:cleanup-rehearsal": "node -r ts-node/register --test test/productionTestDataCleanup.rehearsal.test.ts",
    "rehearse:cleanup": "node scripts/cleanup/rehearseProductionTestDataCleanup.cjs cleanup-manifests/production-test-data-cleanup-20261013.json",
    "migrate:artifact": "node dist/db/migrateCli.js",
    "start:pira:portal": "node dist/pira/portalServer.js",
    "start:pira:core": "node dist/pira/coreServer.js",
    "test:pira:phase2": "npm run build && node --test test/piraPhase2.test.cjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@google-cloud/secret-manager": "^5.6.0",
    "cookie-parser": "^1.4.6",
    "express": "^4.19.2",
    "google-auth-library": "^9.14.1",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^9.0.3",
    "pg": "^8.11.5",
    "pino": "^9.0.0",
    "pino-http": "^10.0.0",
    "playwright": "1.63.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.63.0",
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.12.12",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.11.6",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  }
}
