FROM node:22-alpine AS deps
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev

FROM node:22-alpine
WORKDIR /app
ARG SOURCE_REVISION
LABEL org.opencontainers.image.revision=$SOURCE_REVISION
ENV NODE_ENV=production
COPY --from=deps /app/node_modules ./node_modules
COPY dist ./dist
RUN test -f ./dist/db/aiExecutionQueueReadinessVerifierCli.js && node -e "require('./dist/db/aiExecutionQueueReadinessVerifierCli.js')"
USER node
CMD ["node", "dist/db/aiExecutionQueueReadinessVerifierCli.js"]
