FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY tsconfig.json ./
COPY src ./src
RUN npm run build && test -f ./dist/db/deletionReconciliationWindowDiagnosticCli.js && node -e "require('./dist/db/deletionReconciliationWindowDiagnosticCli.js')"
FROM node:22-alpine AS runtime-deps
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev
FROM node:22-alpine
WORKDIR /app
ARG SOURCE_REVISION
LABEL org.opencontainers.image.revision=$SOURCE_REVISION
ENV NODE_ENV=production
COPY --from=runtime-deps /app/node_modules ./node_modules
COPY --from=build /app/dist ./dist
RUN test -f ./dist/db/deletionReconciliationWindowDiagnosticCli.js && node -e "require('./dist/db/deletionReconciliationWindowDiagnosticCli.js')"
USER node
CMD ["node","dist/db/deletionReconciliationWindowDiagnosticCli.js"]
