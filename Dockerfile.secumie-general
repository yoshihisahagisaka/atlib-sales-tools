FROM node:24-trixie-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY tsconfig.json ./
COPY src ./src
RUN npm run build && mkdir -p dist/wsc/vendor/tools && cp -R src/wsc/vendor/tools/wsc-vs1 src/wsc/vendor/tools/wsc-phase2a src/wsc/vendor/tools/wsc-phase2b src/wsc/vendor/tools/wsc-phase2c dist/wsc/vendor/tools/
FROM node:24-trixie-slim AS runtime-deps
WORKDIR /app
# Only packages reached by the dedicated runtime. Lockfile resolution is preserved.
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts
FROM gcr.io/distroless/nodejs24-debian13@sha256:774b396818c5dbc4d9aba312b84d548045939ca6efdadc840a928f205116fc74 AS runtime
WORKDIR /app
ENV NODE_ENV=production
ARG SOURCE_REVISION
LABEL org.opencontainers.image.revision=$SOURCE_REVISION
COPY --from=runtime-deps /app/node_modules ./node_modules
COPY --from=build /app/dist ./dist
COPY prototypes/secumie-general ./prototypes/secumie-general
COPY prototypes/pira-union-diagnosis-v2 ./prototypes/pira-union-diagnosis-v2
USER nonroot
EXPOSE 8080
CMD ["dist/secumieGeneralServer.js"]
