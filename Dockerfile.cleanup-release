FROM node:20-alpine AS deps
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev

FROM node:20-alpine
WORKDIR /app
ARG SOURCE_REVISION
LABEL org.opencontainers.image.revision=$SOURCE_REVISION
ENV NODE_ENV=production
COPY --from=deps /app/node_modules ./node_modules
COPY scripts ./scripts
COPY cleanup-manifest.json artifact-inventory.json ./
USER node
CMD ["node", "scripts/cleanup/runProductionTestDataCleanup.cjs", "cleanup-manifest.json"]
