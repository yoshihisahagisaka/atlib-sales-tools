# Preserve every file except the four compiled notification modules.
ARG BASE_IMAGE
FROM node:24-trixie-slim AS compile
WORKDIR /app
COPY package.json package-lock.json tsconfig.json ./
RUN npm ci --ignore-scripts
COPY src ./src
RUN npm run build
COPY test/secumieConsultationNotification.test.ts ./test/secumieConsultationNotification.test.ts
RUN node -r ts-node/register --test test/secumieConsultationNotification.test.ts
RUN chmod 0644 /app/dist/secumieGeneralServer.js /app/dist/services/mailer.js /app/dist/services/secumieConsultationNotification.js /app/dist/services/secumieGeneralConsultation.js
FROM ${BASE_IMAGE} AS runtime
ARG BASE_IMAGE
ARG SOURCE_REVISION
LABEL org.opencontainers.image.revision=$SOURCE_REVISION com.atlib.overlay.base=$BASE_IMAGE
COPY --from=compile /app/dist/secumieGeneralServer.js /app/dist/secumieGeneralServer.js
COPY --from=compile /app/dist/services/mailer.js /app/dist/services/mailer.js
COPY --from=compile /app/dist/services/secumieConsultationNotification.js /app/dist/services/secumieConsultationNotification.js
COPY --from=compile /app/dist/services/secumieGeneralConsultation.js /app/dist/services/secumieGeneralConsultation.js
USER nonroot
RUN ["/nodejs/bin/node","-e","const fs=require('node:fs'),path=require('node:path'),assert=require('node:assert/strict'),http=require('node:http'),{spawn}=require('node:child_process');\nassert.notEqual(process.getuid(),0);\nfunction walk(p){const s=fs.lstatSync(p);if(s.isDirectory()){fs.accessSync(p,fs.constants.R_OK|fs.constants.X_OK);for(const n of fs.readdirSync(p))walk(path.join(p,n));}else{assert.ok(s.isFile());fs.accessSync(p,fs.constants.R_OK);}}\nfor(const p of ['/app/dist','/app/prototypes/secumie-general','/app/prototypes/pira-union-diagnosis-v2'])walk(p);\nconsole.log('NONROOT_APPLICATION_TREE_READ=PASS');\nconst sleep=ms=>new Promise(r=>setTimeout(r,ms));\nfunction get(port,p){return new Promise((resolve,reject)=>{const q=http.get({host:'127.0.0.1',port,path:p,headers:{Host:'service.atlib.jp'}},r=>{const b=[];r.on('data',x=>b.push(x));r.on('end',()=>resolve({status:r.statusCode,body:Buffer.concat(b).toString('utf8')}));r.on('error',reject);});q.setTimeout(2000,()=>q.destroy(Error('local HTTP timeout')));q.on('error',reject);});}\nasync function test(kind,port){const prefix=kind==='WEB'?'/secumie-web/':'/secumie-insight/';const env={...process.env,PORT:String(port),SECUMIE_GENERAL_KIND:kind,SECUMIE_GENERAL_ENABLED:'true',SECUMIE_GENERAL_HOST:'service.atlib.jp',SECUMIE_TURNSTILE_SITE_KEY:'synthetic_site_key',SECUMIE_TURNSTILE_SECRET:'synthetic_secret',SECUMIE_GENERAL_DB_NAME:'secumie_general',SECUMIE_GENERAL_DB_USER:'secumie_general_writer_prod',SECUMIE_GENERAL_DB_PASSWORD:'x'.repeat(40),SECUMIE_GENERAL_DB_HOST:'127.0.0.1',SECUMIE_GENERAL_DB_PORT:'1',SECUMIE_GENERAL_RECEIPT_SECRET:'r'.repeat(64),SMTP_HOST:'127.0.0.1',SMTP_USER:'synthetic@example.invalid',SMTP_PASSWORD:'synthetic',SMTP_FROM:'synthetic@example.invalid',SECUMIE_CONSULTATION_NOTIFY_EMAIL:'synthetic@example.invalid'};const child=spawn(process.execPath,['/app/dist/secumieGeneralServer.js'],{cwd:'/app',env,stdio:['ignore','inherit','inherit']});let exit=false;child.on('exit',()=>{exit=true});try{let ready=false;for(let i=0;i<40;i++){assert.ok(!exit,'runtime exited');try{const h=await get(port,'/healthz/');if(h.status===200){ready=true;break;}}catch{}await sleep(250);}assert.ok(ready,'runtime health failed');const page=await get(port,prefix);assert.equal(page.status,200,'guide HTTP '+kind);assert.ok(page.body.includes('id=\"general-intake\"')&&page.body.includes('原則2年間保存')&&!page.body.includes('__GENERAL_SITE_KEY__'),'guide marker '+kind);for(const name of ['general.js','general.css',kind==='WEB'?'secumie-web.png':'secumie-insight.png',...(kind==='INSIGHT'?['engine/v6.js','engine/v6-content.js','engine/v7-prototype.js','materials/PIRA_Incident_Response_Guide_v1.pdf']:[])]){const a=await get(port,prefix+name);assert.equal(a.status,200,kind+' '+name);assert.ok(a.body.length>0);}console.log('NONROOT_ENABLED_GUIDE_ASSETS=PASS; KIND='+kind);}finally{child.kill('SIGTERM');if(!exit){await Promise.race([new Promise(r=>child.once('exit',r)),sleep(1500)]);if(!exit)child.kill('SIGKILL');}}}\n(async()=>{await test('WEB',18080);await test('INSIGHT',18081);console.log('GENERAL_PERMISSION_OVERLAY_SMOKE=PASS; NO_DB_OR_EXTERNAL_REQUEST');})().catch(e=>{console.error(e.message);process.exitCode=1;});"]
RUN ["/nodejs/bin/node","-e","const assert=require('node:assert/strict');const n=require('/app/dist/services/secumieConsultationNotification.js');const v={kind:'WEB',companyName:'Synthetic',personName:'Person',email:'sample@example.invalid',phone:'000',receivedAt:'2026-11-28T15:30:57Z',reference:'synthetic',report:{raw:'RAW_REPORT_MARKER'}};assert(!n.formatSecumieConsultationNotification(v).text.includes('RAW_REPORT_MARKER'));assert(n.formatSecumieConsultationNotification(v).text.includes(n.SECUMIE_GENERAL_ADMIN_URL));assert(!n.formatSecumieConsultationSlack(v).includes(v.email));assert.equal(typeof require('/app/dist/services/slackNotifier.js').sendSlackNotification,'function');console.log('NOTIFICATION_OVERLAY_NONROOT=PASS');"]
