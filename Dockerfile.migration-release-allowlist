# Generated contexts contain only the reviewed allowlist and this Dockerfile.
ARG SOURCE_REVISION
FROM node:20-alpine AS deps
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev

FROM node:20-alpine
WORKDIR /app
ARG SOURCE_REVISION
LABEL org.opencontainers.image.revision=$SOURCE_REVISION
ENV NODE_ENV=production
COPY --from=deps /app/node_modules ./node_modules
COPY dist ./dist
RUN test -f ./dist/db/migrateCli.js && node -e "require('./dist/db/migrateCli.js')"
COPY migrations ./migrations
COPY manifest.json ./migration-release-manifest.json
USER node
CMD ["node", "dist/db/migrateCli.js"]
