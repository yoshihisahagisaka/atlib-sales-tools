# Build context must be generated by scripts/migration/buildAllowlistArtifact.cjs.
# The generated context contains only approved SQL under migrations/.
ARG SOURCE_REVISION
FROM node:22-alpine AS deps
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev

FROM node:22-alpine
WORKDIR /app
ARG SOURCE_REVISION
LABEL org.opencontainers.image.revision=$SOURCE_REVISION
ENV NODE_ENV=production
COPY --from=deps /app/node_modules ./node_modules
COPY dist ./dist
COPY migrations ./migrations
COPY manifest.json ./migration-allowlist-manifest.json
USER node
CMD ["node", "dist/db/migrateCli.js"]
