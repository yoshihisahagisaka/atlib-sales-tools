# このファイルはテンプレートです。実際の値は絶対にコミットしないこと。
# 本番(Cloud Run)ではこれらは Secret Manager / --set-env-vars 経由で注入する。

NODE_ENV=development
PORT=8080

# GCP
GCP_PROJECT_ID=msp-zabbix

# DB (本番は Cloud SQL Unix socket 経由。ローカル開発時はCloud SQL Auth Proxyを別途起動するか、
#     ローカルPostgresを使う場合は DB_HOST/DB_PORT を使う)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=sales_tools
DB_USER=sales_tools_app
DB_PASSWORD=change-me-in-local-dev-only
# Cloud Run本番用（設定されていればこちらを優先しUnixソケット接続する）
DB_SOCKET_PATH=

# SMTP (Gmail/Workspace個人メールボックス経由)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=change-me@atlib.jp
SMTP_PASSWORD=change-me
SMTP_FROM=change-me@atlib.jp

# 通知メール内の管理画面リンク生成用
PORTAL_BASE_URL=https://sales.atlib.jp

# 管理画面(/admin/*)のGoogle Workspace認証 (msp-customer-portalと同じOAuthクライアントを共用。
#      GCP Consoleのリダイレクト URIにsales.atlib.jp/auth/callbackを追加登録して使う。
#      クライアントシークレットは本番 Secret Manager: sales-tools-google-oauth-client-secret)
# ログイン許可はatlib.jpドメインのGoogle Workspaceアカウント全員(hdクレームで検証、コード内に直書き)。
# ロール区分は無い(管理画面内に権限差が必要なページが無いため)。
GOOGLE_OAUTH_CLIENT_ID=change-me.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=change-me
# スタッフ用セッション/state JWTの署名鍵 (本番は Secret Manager: sales-tools-staff-jwt-secret)
STAFF_JWT_SECRET=change-me-in-local-dev-only

# ISMS診断フォーム: 新規回答の通知先（カンマ区切りで複数可）
DIAGNOSTIC_NOTIFY_EMAIL=sales@atlib.jp

# Slack通知(任意。未設定でも動作する。メール通知に加えてSlackにも送りたい場合のみ設定)
SLACK_WEBHOOK_DIAGNOSTIC=

# 原価見積ツール AI提案機能(任意。未設定でもアプリは起動し、AI提案パネルのみ503を返す)
# 本番は Secret Manager: sales-tools-anthropic-api-key
ANTHROPIC_API_KEY=
